{
  "extends": "../shared/tsconfig.settings",
    "compilerOptions": {
    "outDir": "./dist/",
    "jsx": "react",
    "skipLibCheck": true,
    "typeRoots": ["./src/@types", "./node_modules/@types"],
    "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "include": ["./src/"],
  "exclude": ["**/node_modules/**"]
}
